<UserControl x:Class="HotKeyCommandApp.Views.Controls.GitDiffRepositoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HotKeyCommandApp.Views.Controls"
             Background="#1E1E1E" Foreground="#D4D4D4"
             PreviewKeyDown="View_PreviewKeyDown" PreviewMouseLeftButtonDown="View_PreviewMouseLeftButtonDown">
    <UserControl.Resources>
        <SolidColorBrush x:Key="UnstagedAccentBrush" Color="#E5B567"/>
        <SolidColorBrush x:Key="StagedAccentBrush" Color="#8BD5A4"/>
        <SolidColorBrush x:Key="UnstagedHeaderBrush" Color="#332C20"/>
        <SolidColorBrush x:Key="StagedHeaderBrush" Color="#23382C"/>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SectionActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ButtonContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#005A86"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#75BEFF"/>
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B8E4FF"/>
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#004A78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FileLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#75BEFF"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#75BEFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#252526" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid x:Name="RepositoryHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="RepositorySummary" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RepositoryNameText" Text="{Binding RepositoryName}" FontSize="17"
                               FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <StackPanel x:Name="TrackingStatus" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                ToolTip="{Binding TrackingStatusToolTip}">
                        <StackPanel x:Name="TrackingCounts" Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTrackingCounts}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock x:Name="AheadCountText" Text="{Binding AheadBy, StringFormat='↑{0}'}"
                                       Foreground="#A6E3A1" FontSize="14" FontWeight="SemiBold" ToolTip="ahead: ローカル側だけにあるコミット数"/>
                            <TextBlock x:Name="BehindCountText" Text="{Binding BehindBy, StringFormat='↓{0}'}"
                                       Foreground="#F38BA8" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0"
                                       ToolTip="behind: リモート側だけにあるコミット数"/>
                        </StackPanel>
                        <TextBlock x:Name="TrackingStatusText" Text="{Binding TrackingStatusText}" FontSize="13" Foreground="#A0C4E2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTrackingCounts}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button x:Name="PushButton" Content="プッシュ" Style="{StaticResource HeaderButtonStyle}"
                                Click="PushButton_Click" IsEnabled="{Binding CanOperateCurrentBranch}"/>
                        <Button x:Name="PullButton" Content="プル" Style="{StaticResource HeaderButtonStyle}"
                                Click="PullButton_Click" IsEnabled="{Binding CanOperateCurrentBranch}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="更新 (F5)" Click="RefreshButton_Click" Margin="16,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Grid x:Name="BranchHeader" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentBranchText" Text="{Binding CurrentBranch, StringFormat='ブランチ: {0}'}"
                               Foreground="#58A6FF" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentBranch}"/>
                    <Button x:Name="RenameBranchButton" Grid.Column="1" Click="RenameBranchButton_Click"
                            Style="{StaticResource HeaderButtonStyle}" IsEnabled="{Binding CanOperateCurrentBranch}"
                            Width="30" Margin="6,0,0,0" Padding="0" ToolTip="ブランチ名を変更"
                            AutomationProperties.Name="ブランチ名を変更">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button x:Name="CopyCurrentBranchButton" Grid.Column="2" Content="⧉" Style="{StaticResource HeaderButtonStyle}"
                            Click="CopyCurrentBranchButton_Click" IsEnabled="{Binding CanCopyCurrentBranch}" Margin="6,0,0,0"
                            ToolTip="現在のブランチ名をコピー" AutomationProperties.Name="現在のブランチ名をコピー"/>
                </Grid>
                <TextBlock x:Name="BaseBranchText" Grid.Row="2" Grid.ColumnSpan="2"
                           Text="{Binding BaseBranchDisplay, StringFormat='ベース: {0}'}" ToolTip="{Binding BaseBranchDisplay}"
                           Foreground="#E5A93C" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
            </Grid.ColumnDefinitions>
            <Border Background="#252526">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="変更ファイル" FontWeight="SemiBold" Margin="14,13,14,4"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,6,8,8">
                        <Button x:Name="CommitStagedButton" Content="ステージ済みをコミット" Click="CommitStagedButton_Click" Padding="8,5">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStagedChanges}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Binding OperationStatus}" Foreground="#D4D4D4" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="90"/>
                    </StackPanel>
                    <ListBox x:Name="FileList" ItemsSource="{Binding FileView}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                             Background="Transparent" Foreground="#D4D4D4" BorderThickness="0" Padding="6,0,6,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="FileList_SelectionChanged">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border x:Name="SectionHeader" Background="{StaticResource UnstagedHeaderBrush}"
                                                BorderBrush="{StaticResource UnstagedAccentBrush}" BorderThickness="3,0,0,0"
                                                Margin="0,10,0,5" Padding="7,7">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="{Binding ItemCount}" DockPanel.Dock="Right" MinWidth="18" TextAlignment="Right"
                                                           Foreground="{Binding Foreground, ElementName=SectionTitle}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <Button x:Name="SectionActionButton" DockPanel.Dock="Right" Content="すべてステージ"
                                                        Click="SectionActionButton_Click" Padding="5,3" FontSize="11" Margin="6,0,0,0"
                                                        Foreground="{StaticResource UnstagedAccentBrush}" BorderBrush="{StaticResource UnstagedAccentBrush}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SectionActionButtonStyle}">
                                                            <Setter Property="ToolTip" Value="このリポジトリの未ステージ変更をすべてステージ"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=controls:GitDiffRepositoryView}}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <TextBlock x:Name="SectionTitle" Text="{Binding Name}" Foreground="{StaticResource UnstagedAccentBrush}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="ステージ済み">
                                                <Setter TargetName="SectionHeader" Property="Background" Value="{StaticResource StagedHeaderBrush}"/>
                                                <Setter TargetName="SectionHeader" Property="BorderBrush" Value="{StaticResource StagedAccentBrush}"/>
                                                <Setter TargetName="SectionTitle" Property="Foreground" Value="{StaticResource StagedAccentBrush}"/>
                                                <Setter TargetName="SectionActionButton" Property="Content" Value="すべて解除"/>
                                                <Setter TargetName="SectionActionButton" Property="ToolTip" Value="作業中のファイルを残して、このリポジトリのステージをすべて解除"/>
                                                <Setter TargetName="SectionActionButton" Property="Foreground" Value="{StaticResource StagedAccentBrush}"/>
                                                <Setter TargetName="SectionActionButton" Property="BorderBrush" Value="{StaticResource StagedAccentBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Padding" Value="8,7"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="StateIndicator" BorderBrush="{StaticResource UnstagedAccentBrush}" BorderThickness="3,0,0,0">
                                                <Border x:Name="Row" Background="#2C2822" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsStaged}" Value="True">
                                                    <Setter TargetName="StateIndicator" Property="BorderBrush" Value="{StaticResource StagedAccentBrush}"/>
                                                    <Setter TargetName="Row" Property="Background" Value="#232F29"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#303033"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#303033"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                  <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True"/>
                                                    <Condition Property="IsKeyboardFocused" Value="True"/>
                                                  </MultiTrigger.Conditions>
                                                    <Setter TargetName="Row" Property="Background" Value="#163849"/>
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="#007ACC"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding DisplayPath}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button x:Name="FileOpenButton" Style="{StaticResource FileLinkButtonStyle}" Click="FileNameButton_Click"
                                            MouseDoubleClick="FileNameButton_MouseDoubleClick" Tag="{Binding}" ToolTip="ダブルクリックで VS Code で開く" Focusable="False">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DirectoryName}" Foreground="#999999" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding Change}" Foreground="#8CBFE5" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <Button x:Name="FileCopyButton" Grid.Column="2" Content="⧉" ToolTip="ファイル名をコピー" Click="CopyFileNameButton_Click"
                                            Padding="5,2" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    <Button x:Name="FileStageButton" Grid.Column="3" Click="StageFileButton_Click" Padding="5,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="ステージ"/>
                                                <Setter Property="ToolTip" Value="このファイルをステージ"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStaged}" Value="True">
                                                        <Setter Property="Content" Value="解除"/><Setter Property="ToolTip" Value="このファイルのステージを解除"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=controls:GitDiffRepositoryView}}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button x:Name="FileDiscardButton" Grid.Column="4" Content="破棄" ToolTip="このファイルの未ステージ変更を破棄" Click="FileRowDiscardButton_Click"
                                            Padding="5,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStaged}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsConflicted}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Change}" Value="名前変更"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=controls:GitDiffRepositoryView}}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#3A3A3A"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#252526" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="14,12">
                  <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontFamily="Consolas" Foreground="#B0C4B1" Margin="16,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="⧉" Click="CopySelectedFileNameButton_Click" Padding="5,2" Margin="8,0,0,0"
                                ToolTip="ファイル名をコピー"/>
                        <StackPanel>
                            <Button x:Name="SelectedFilePathBox" Style="{StaticResource FileLinkButtonStyle}" Tag="{Binding SelectedFile}"
                                    Click="FileNameButton_Click" MouseDoubleClick="FileNameButton_MouseDoubleClick"
                                    FontWeight="SemiBold" ToolTip="ダブルクリックで VS Code で開く">
                                <TextBlock Text="{Binding SelectedFilePath}" TextTrimming="CharacterEllipsis"/>
                            </Button>
                            <TextBlock Text="{Binding SelectedFile.Comparison}" Foreground="#999999" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="選択行をステージ" Click="StageLinesButton_Click" Padding="8,4" Margin="0,0,6,0"
                                IsEnabled="{Binding CanStageLines}" ToolTip="差分コード内で選択した追加行・削除行をステージ"/>
                        <Button Content="選択行を破棄" Click="DiscardLinesButton_Click" Padding="8,4" Margin="0,0,6,0"
                                IsEnabled="{Binding CanStageLines}" ToolTip="選択した未ステージの変更行を元に戻す"/>
                        <Button Content="ファイルの変更を破棄" Click="DiscardFileButton_Click" Padding="8,4"
                                IsEnabled="{Binding CanDiscardFile}" ToolTip="このファイルの未ステージ変更を元に戻す"/>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Button x:Name="DecreaseDiffFontButton" Content="−" Width="25" Padding="0,4" Click="DecreaseDiffFontButton_Click"
                                    ToolTip="差分の文字を小さくする" AutomationProperties.Name="差分の文字を小さくする"/>
                            <TextBlock x:Name="DiffFontSizeText" Text="12" Width="28" TextAlignment="Center" VerticalAlignment="Center"
                                       ToolTip="差分の文字サイズ"/>
                            <Button x:Name="IncreaseDiffFontButton" Content="＋" Width="25" Padding="0,4" Click="IncreaseDiffFontButton_Click"
                                    ToolTip="差分の文字を大きくする" AutomationProperties.Name="差分の文字を大きくする"/>
                        </StackPanel>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#B7B7B7">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="16,14"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <controls:GitDiffTextView x:Name="DiffLines" Grid.Row="2" TextElement.FontFamily="Consolas" TextElement.FontSize="12"/>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#252526" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="12,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="↑↓: ファイル選択  ·  Tab: フォーカス移動  ·  F5: 更新  ·  Alt+F4: 閉じる" Foreground="#999999" FontSize="11" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding Overview}" Foreground="#A8A8A8" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
