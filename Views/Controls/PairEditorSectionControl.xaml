<UserControl x:Class="HotKeyCommandApp.Views.Controls.PairEditorSectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HotKeyCommandApp.Views.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Style="{StaticResource SettingsNonFocusableScrollViewerStyle}">
        <Grid Margin="5,5,5,10">
            <controls:AliasPairEditorControl x:Name="PairEditor"
                                             ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ItemsSource}"
                                             FolderItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FolderItemsSource}"
                                             FirstHeader="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FirstHeader}"
                                             SecondHeader="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SecondHeader}"
                                             ShowColumnHeaders="False"/>
        </Grid>
    </ScrollViewer>
</UserControl>
