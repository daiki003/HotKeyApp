<UserControl x:Class="HotKeyCommandApp.Views.Controls.SettingsRecordButtonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Button x:Name="RowButton"
            Style="{StaticResource SettingsRecordButtonStyle}"
            Click="RowButton_Click"
            PreviewKeyDown="RowButton_PreviewKeyDown">
        <Grid Margin="{Binding ContentMargin, ElementName=Root}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding LeadingColumnWidth, ElementName=Root}"/>
                <ColumnDefinition Width="{Binding LabelColumnWidth, ElementName=Root}"/>
                <ColumnDefinition Width="{Binding ValueColumnWidth, ElementName=Root}"/>
                <ColumnDefinition Width="{Binding TrailingColumnWidth, ElementName=Root}"/>
            </Grid.ColumnDefinitions>

            <ContentPresenter Grid.Column="0"
                              Content="{Binding LeadingContent, ElementName=Root}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding LabelText, ElementName=Root}"
                       Foreground="{Binding LabelForeground, ElementName=Root}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Grid.Column="2"
                       Text="{Binding ValueText, ElementName=Root}"
                       Foreground="{Binding ValueForeground, ElementName=Root}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="{Binding ValueTextMargin, ElementName=Root}"
                       TextTrimming="CharacterEllipsis"/>

            <ContentPresenter Grid.Column="3"
                              Content="{Binding TrailingContent, ElementName=Root}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"/>
        </Grid>
    </Button>
</UserControl>
