<Window x:Class="HotKeyCommandApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HotKeyCommandApp.Views.Controls"
        Title="Settings" 
        Width="700" Height="600"
        Foreground="White"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <controls:SettingsDialogShell x:Name="SettingsShell"
                                  HeaderTitle="設定"
                                  HeaderActionText="settings.jsonを開く">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:SettingsTabControl x:Name="MainTabControl"
                                         Grid.Row="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Margin="0,0,0,10"
                                         ItemContainerStyle="{StaticResource SettingsDialogTabItemStyle}">
                <TabItem Header="サイズ調整">
                    <controls:SizeSettingsSectionControl x:Name="SizePanel"/>
                </TabItem>

                <TabItem Header="ショートカット">
                    <controls:ShortcutSettingsSectionControl x:Name="ShortcutsPanel"/>
                </TabItem>

                <TabItem Header="定数定義">
                    <controls:PairEditorSectionControl x:Name="ConstantsPanel"
                                                       ItemsSource="{Binding EditingConstants}"
                                                       FolderItemsSource="{Binding EditingConstantFolders}"
                                                       FirstHeader="定数名"
                                                       SecondHeader="値"/>
                </TabItem>

                <TabItem Header="選択式テンプレート">
                    <controls:PairEditorSectionControl x:Name="SelectTemplatesPanel"
                                                       ItemsSource="{Binding EditingSelectTemplates}"
                                                       FolderItemsSource="{Binding EditingSelectTemplateFolders}"
                                                       FirstHeader="テンプレート名"
                                                       SecondHeader="選択肢 (カンマ区切り)"/>
                </TabItem>

                <TabItem Header="その他">
                    <controls:OthersSettingsSectionControl x:Name="OthersPanel"/>
                </TabItem>
            </controls:SettingsTabControl>

            <StackPanel Grid.Row="1">
                <TextBlock x:Name="FooterHintTextBlock"
                           Text="PageUp / PageDown でタブ切替  Ctrl+Enter で保存"
                           Foreground="#666666"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="キャンセル"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="Close_Click"
                            Margin="0,0,10,0"/>
                    <Button x:Name="SaveButton"
                            Content="保存して閉じる"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Background="#007ACC"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </controls:SettingsDialogShell>
</Window>
