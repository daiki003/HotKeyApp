<Window x:Class="HotKeyCommandApp.Views.PresetSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HotKeyCommandApp.Views.Controls"
        Title="プリセット選択"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="HeaderOnlyTabControlStyle" TargetType="{x:Type controls:SettingsTabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:SettingsTabControl}">
                        <TabPanel IsItemsHost="True"
                                  Background="Transparent"
                                  KeyboardNavigation.TabIndex="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetListItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Height" Value="{Binding DataContext.ButtonHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#2D2D2D"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#333337" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E42" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#007ACC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Value}" Value="ADD_BUTTON">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="Width" Value="{Binding DataContext.ButtonHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                    <Setter Property="Height" Value="{Binding DataContext.ButtonHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                    <Setter Property="Margin" Value="0,5,0,5"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid>
                                    <Border x:Name="ItemBorder"
                                            Background="#007ACC"
                                            CornerRadius="100"
                                            BorderThickness="1"
                                            BorderBrush="#007ACC">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.CreatePresetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                        </Border.InputBindings>
                                        <TextBlock Text="+"
                                                   Foreground="White"
                                                   FontSize="32"
                                                   FontWeight="Light"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,-6,0,0"/>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#108BDE" />
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#005A9E" />
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="White" />
                                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <controls:SettingsDialogShell HeaderTitle="プリセット選択"
                                  HeaderActionVisibility="Collapsed">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:SettingsTabControl x:Name="CategoryTabControl"
                                         Grid.Row="0"
                                         Style="{StaticResource HeaderOnlyTabControlStyle}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Margin="0,0,0,10"
                                         ItemsSource="{Binding Categories}"
                                         SelectedItem="{Binding SelectedCategory}"
                                         ItemContainerStyle="{StaticResource SettingsDialogTabItemStyle}">
                <controls:SettingsTabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </controls:SettingsTabControl.ItemTemplate>
            </controls:SettingsTabControl>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="PresetListBox"
                         Grid.Row="0"
                         ItemsSource="{Binding VisiblePresetItems}"
                         SelectedItem="{Binding SelectedListItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource PresetListItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="White"
                                           FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1"
                           Text="{Binding Description}"
                           Foreground="#A8A8A8"
                           Margin="4,6,4,0"
                           TextWrapping="Wrap" />
            </Grid>

            <StackPanel Grid.Row="2"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left">
                <TextBlock Text="PageUp / PageDown : タブ切り替え"
                           Foreground="#666666"
                           FontSize="11"
                           Margin="0,0,0,4" />
                <TextBlock Text="Ctrl + + : 新しいプリセットを作成"
                           Foreground="#666666"
                           FontSize="11"
                           Margin="0,0,0,4" />
            </StackPanel>
        </Grid>
    </controls:SettingsDialogShell>
</Window>
