<Window x:Class="HotKeyCommandApp.Views.GitDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:HotKeyCommandApp.Models"
        Title="未コミットの差分" Width="1120" Height="720" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="#D4D4D4"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#252526" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="更新 (F5)" Click="RefreshButton_Click" Margin="16,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRefreshing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding RepositoryName}" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding CurrentBranch, StringFormat='ブランチ: {0}'}" Foreground="#58A6FF" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentBranch}"/>
                    <TextBlock Text="未コミットの変更" Foreground="#A8A8A8" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
            </Grid.ColumnDefinitions>
            <Border Background="#252526">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="変更ファイル" FontWeight="SemiBold" Margin="14,13,14,4"/>
                    <ListBox x:Name="FileList" ItemsSource="{Binding FileView}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                             Background="Transparent" Foreground="#D4D4D4" BorderThickness="0" Padding="6,0,6,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="FileList_SelectionChanged">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="8,14,8,7">
                                            <TextBlock Text="{Binding ItemCount}" DockPanel.Dock="Right" Foreground="#999999"/>
                                            <TextBlock Text="{Binding Name}" Foreground="#B7B7B7" FontWeight="SemiBold"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Padding" Value="8,7"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#303033"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#163849"/>
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="#007ACC"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding DisplayPath}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}" Foreground="#EEEEEE" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DirectoryName}" Foreground="#999999" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Change}" Foreground="#8CBFE5" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#3A3A3A"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#252526" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="14,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontFamily="Consolas" Foreground="#B0C4B1" Margin="16,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedFilePath}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFilePath}"/>
                            <TextBlock Text="{Binding Comparison}" Foreground="#999999" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#B7B7B7">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="16,14"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox x:Name="DiffLines" Grid.Row="2" ItemsSource="{Binding Lines}" Background="#1E1E1E" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1E1E1E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:GitDiffLineKind.Added}"><Setter Property="Background" Value="#183D2A"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:GitDiffLineKind.Deleted}"><Setter Property="Background" Value="#4B2428"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:GitDiffLineKind.Hunk}"><Setter Property="Background" Value="#20364B"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OldNumber}" Foreground="#999999" TextAlignment="Right" Margin="0,0,9,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding NewNumber}" Foreground="#999999" TextAlignment="Right" Margin="0,0,9,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Marker}" Foreground="#C8C8C8" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Text}" Foreground="#E0E0E0" Margin="0,0,16,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#252526" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="12,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="↑↓: ファイル選択  ·  Tab: フォーカス移動  ·  F5: 更新  ·  Esc: 閉じる" Foreground="#999999" FontSize="11" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding Overview}" Foreground="#A8A8A8" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
