<Window x:Class="HotKeyCommandApp.Views.GitDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HotKeyCommandApp.Views.Controls"
        Title="未コミットの差分" Width="1120" Height="720" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Background="#1E1E1E" Foreground="#D4D4D4"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="RepositoryTabHeader">
            <Border Background="Transparent" Tag="{Binding RelativeSource={RelativeSource AncestorType=TabItem}}"
                    ToolTip="ドラッグで並べ替え · Ctrl+Shift+PageUp / PageDownで左右へ移動"
                    PreviewMouseLeftButtonDown="TabHeader_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="TabHeader_PreviewMouseMove"
                    AllowDrop="True" DragOver="TabHeader_DragOver" Drop="TabHeader_Drop">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" ToolTip="タブを閉じる (Ctrl+W)"
                            Tag="{Binding RelativeSource={RelativeSource AncestorType=TabItem}}"
                            Click="CloseTabButton_Click" Style="{StaticResource ActionButtonStyle}"
                            Width="22" Height="22" Padding="0" Margin="8,0,0,0"
                            Background="Transparent" Foreground="#BBBBBB" BorderThickness="0"/>
                    <TextBlock Text="{Binding RepositoryName}" VerticalAlignment="Center"
                               MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="RepositoryTabStyle" TargetType="TabItem" BasedOn="{StaticResource SettingsDialogTabItemStyle}">
            <Setter Property="HeaderTemplate" Value="{StaticResource RepositoryTabHeader}"/>
        </Style>
    </Window.Resources>
    <controls:SettingsTabControl x:Name="RepositoryTabs" Background="#1E1E1E"
                                 BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource RepositoryTabStyle}"
                                 SelectionChanged="RepositoryTabs_SelectionChanged"/>
</Window>
