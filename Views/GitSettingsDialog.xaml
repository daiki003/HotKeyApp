<Window x:Class="HotKeyCommandApp.Views.GitSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HotKeyCommandApp.Views.Controls"
        Title="Git設定"
        Height="600"
        Width="700"
        Background="#1E1E1E"
        Foreground="White"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <controls:SettingsDialogShell x:Name="SettingsShell"
                                  HeaderTitle="Git 設定"
                                  HeaderActionText="git_settings.jsonを開く">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="MainTabControl"
                        Grid.Row="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="0,0,0,10"
                        ItemContainerStyle="{StaticResource SettingsDialogTabItemStyle}">
                <TabItem Header="エイリアス">
                    <Grid Margin="0,10,0,0">
                        <controls:AliasPairEditorControl x:Name="AliasesPairEditor"
                                                         TabHost="{Binding TabHost}"
                                                         FirstHeader="エイリアス名"
                                                         SecondHeader="対象コマンド"
                                                         ShowColumnHeaders="False"/>
                    </Grid>
                </TabItem>

                <TabItem Header="関数">
                    <controls:GitFunctionsSectionControl x:Name="FunctionsPanel"/>
                </TabItem>

                <TabItem Header="リポジトリ名">
                    <Grid Margin="0,10,0,0">
                        <controls:AliasPairEditorControl x:Name="MappingsPairEditor"
                                                         ItemsSource="{Binding RepositoryNameMappings}"
                                                         FirstHeader="リポジトリパス"
                                                         SecondHeader="表示名"
                                                         ShowColumnHeaders="False"
                                                         FolderItemsSource="{Binding RepositoryNameMappingFolders}"
                                                         FirstColumnWidth="280"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="キャンセル"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="Close_Click"
                        Margin="0,0,10,0"/>
                <Button x:Name="SaveAndCloseButton"
                        Content="保存して閉じる"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Background="#007ACC"
                        Click="SaveAndClose_Click"/>
            </StackPanel>
        </Grid>
    </controls:SettingsDialogShell>
</Window>
