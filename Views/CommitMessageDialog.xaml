<Window x:Class="HotKeyCommandApp.Views.CommitMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="コミット" Width="480" Height="280" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="#2D2D2D" CornerRadius="12" BorderBrush="#007ACC" BorderThickness="2" Padding="20">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="HeadingText" Text="現在の変更をすべてコミット" Foreground="White" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="DescriptionText" Grid.Row="1" Text="新規・削除・ステージ済みの変更を含みます。" Foreground="#AAAAAA" Margin="0,8,0,10"/>
            <TextBox x:Name="MessageBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Foreground="White" Background="#3D3D3D" BorderBrush="#555555" CaretBrush="White" Padding="8" FontSize="14"/>
            <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#F85149" Margin="0,6,0,0"/>
            <DockPanel Grid.Row="4" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="コミット" Click="CommitButton_Click" Foreground="White" Background="#007ACC" Padding="14,5" Margin="0,0,8,0"/>
                    <Button x:Name="CancelButton" Content="キャンセル" IsCancel="True" Foreground="White" Background="#444444" Padding="14,5"/>
                </StackPanel>
                <TextBlock Text="Enter: 実行 / Shift+Enter: 改行" Foreground="#999999" FontSize="10" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
