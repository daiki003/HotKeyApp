<Window x:Class="HotKeyCommandApp.Views.GitCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HotKeyCommandApp.Views"
        Title="Git Command" Height="320" Width="450"
        MinWidth="300" MinHeight="200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8"/>
    </WindowChrome.WindowChrome>
    <Border Background="#1E1E1E" CornerRadius="8">
        <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#333333"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMoveMode}" Value="True">
                            <Setter Property="BorderBrush" Value="#007ACC"/>
                            <Setter Property="BorderThickness" Value="4"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHistoryMode}" Value="True">
                            <Setter Property="BorderBrush" Value="#E5A93C"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RepositoryName}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ParentBranch, StringFormat='Base: {0}'}"
                               Foreground="#E5A93C"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Bottom">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ParentBranch}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Click="SettingsButton_Click" Background="Transparent" BorderThickness="0" Padding="5" Cursor="Hand" ToolTip="Git設定 (Ctrl+,)">
                    <TextBlock Text="⚙" Foreground="#888888" FontSize="16"/>
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,4,0,10" Orientation="Horizontal">
                <TextBlock Text="{Binding CurrentBranch}"
                           Foreground="#58A6FF"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="(Base)"
                           Foreground="#E5A93C"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="8,0,0,0"
                           VerticalAlignment="Bottom">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentBranchBase}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            
            <Border Grid.Row="2" Background="#121212" CornerRadius="4" BorderBrush="#2D2D2D" BorderThickness="1" Margin="0,0,0,12" Padding="8">
                <DockPanel LastChildFill="True">
                                        <Grid DockPanel.Dock="Top"
                          Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="コマンド:"
                                   Foreground="#888888"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentCommandName}"
                                       Foreground="#D4D4D4"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentCommandStatus}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A6E3A1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentCommandStatus}" Value="実行中">
                                                <Setter Property="Foreground" Value="#58A6FF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentCommandStatus}" Value="キャンセル">
                                                <Setter Property="Foreground" Value="#E5A93C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentCommandStatus}" Value="完了">
                                                <Setter Property="Foreground" Value="#A6E3A1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentCommandStatus}" Value="エラー">
                                                <Setter Property="Foreground" Value="#F85149"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
<Border DockPanel.Dock="Bottom"
                            Margin="0,8,0,0"
                            Padding="8"
                            Background="#181818"
                            BorderBrush="#2D2D2D"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding WaitingCommandsText, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding WaitingCommandsText}"
                                   Foreground="#A6E3A1"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   LineHeight="16"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <ScrollViewer x:Name="ConsoleScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="ConsoleScrollViewer_ScrollChanged">
                        <TextBlock Text="{Binding ConsoleOutput}" Foreground="#D4D4D4" FontFamily="Consolas" FontSize="12" LineHeight="18" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            
            <TextBox x:Name="CommandInputBox" Grid.Row="3" 
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                     BorderThickness="0" 
                     VerticalContentAlignment="Center" Padding="8,0"
                     FontSize="14" Height="32"
                     PreviewKeyDown="CommandInputBox_PreviewKeyDown">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="#2D2D2D"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMoveMode}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHistoryMode}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </TextBox.Resources>
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding ExecuteCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Border Grid.RowSpan="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,12,0"
                    Padding="10"
                    Background="#121212"
                    BorderBrush="#007ACC"
                    BorderThickness="1"
                    CornerRadius="6"
                    MaxWidth="240"
                    Panel.ZIndex="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMoveMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="ウィンドウ移動モード"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="・矢印: ウィンドウ移動&#x0a;・Shift+矢印: サイズ変更&#x0a;・Esc: 移動モード終了"
                               Foreground="#D4D4D4"
                               FontFamily="Consolas"
                               FontSize="11"
                               LineHeight="16"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
