<Window x:Class="HotKeyCommandApp.Views.GitCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HotKeyCommandApp.Views"
        Title="Git Command" Height="320" Width="450"
        MinWidth="300" MinHeight="200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <!-- 標準テーマの無効化時の白背景を避けるため、追加するボタンもこの共通スタイルを継承する。 -->
        <Style x:Key="GitActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="BorderBrush" Value="#58A6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource GitActionButtonStyle}"/>
        <Style x:Key="RepositoryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource GitActionButtonStyle}">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBranchOperationBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="BranchRowTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}" Foreground="#D4D4D4" FontFamily="Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding TrackingStatusText}" ToolTip="{Binding TrackingStatusToolTip}"
                           Foreground="#AAAAAA" FontFamily="Consolas" FontSize="11" Margin="8,0,6,0" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Width="44" Content="{Binding PrimaryActionText}" Tag="move" Click="BranchButton_Click" GotKeyboardFocus="BranchButton_GotKeyboardFocus">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GitActionButtonStyle}">
                            <Setter Property="Margin" Value="3,0,0,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="3" Content="削除" Tag="delete" Click="BranchButton_Click" GotKeyboardFocus="BranchButton_GotKeyboardFocus"/>
                <Grid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource GitActionButtonStyle}">
                        <Setter Property="Margin" Value="3,0,0,0"/>
                    </Style>
                </Grid.Resources>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8"/>
    </WindowChrome.WindowChrome>
    <Border Background="#1E1E1E" CornerRadius="8">
        <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#333333"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMoveMode}" Value="True">
                            <Setter Property="BorderBrush" Value="#007ACC"/>
                            <Setter Property="BorderThickness" Value="4"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHistoryMode}" Value="True">
                            <Setter Property="BorderBrush" Value="#E5A93C"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RepositoryName}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ParentBranch, StringFormat='Base: {0}'}"
                               Foreground="#E5A93C"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Bottom">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ParentBranch}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Click="SettingsButton_Click" Background="Transparent" BorderThickness="0" Padding="5" Cursor="Hand" ToolTip="Git設定 (Ctrl+,)">
                    <TextBlock Text="⚙" Foreground="#888888" FontSize="16"/>
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,4,0,10" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel"><Style.Triggers>
                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsOperateMode}" Value="True"/><Condition Binding="{Binding IsStashMode}" Value="False"/>
                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger>
                    </Style.Triggers></Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding CurrentBranch}"
                           Foreground="#58A6FF"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="(Base)"
                           Foreground="#E5A93C"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="8,0,0,0"
                           VerticalAlignment="Bottom">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentBranchBase}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            
            <Border Grid.Row="2" Background="#121212" CornerRadius="4" BorderBrush="#2D2D2D" BorderThickness="1" Margin="0,0,0,12" Padding="8">
                <DockPanel LastChildFill="True">
                                        <Grid DockPanel.Dock="Top"
                          Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="コマンド:"
                                   Foreground="#888888"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentCommandName}"
                                       Foreground="#D4D4D4"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentCommandStatus}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A6E3A1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentCommandStatus}" Value="実行中">
                                                <Setter Property="Foreground" Value="#58A6FF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentCommandStatus}" Value="キャンセル">
                                                <Setter Property="Foreground" Value="#E5A93C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentCommandStatus}" Value="完了">
                                                <Setter Property="Foreground" Value="#A6E3A1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentCommandStatus}" Value="エラー">
                                                <Setter Property="Foreground" Value="#F85149"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
<Border DockPanel.Dock="Bottom"
                            Margin="0,8,0,0"
                            Padding="8"
                            Background="#181818"
                            BorderBrush="#2D2D2D"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding WaitingCommandsText, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding WaitingCommandsText}"
                                   Foreground="#A6E3A1"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   LineHeight="16"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <Grid>
                    <ScrollViewer x:Name="ConsoleScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="ConsoleScrollViewer_ScrollChanged">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOperateMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <TextBlock Text="{Binding ConsoleOutput}" Foreground="#D4D4D4" FontFamily="Consolas" FontSize="12" LineHeight="18" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOperateMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <StackPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStashMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Padding="2" BorderThickness="1" Margin="0,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#333333"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#007ACC"/><Setter Property="Background" Value="#163849"/></Trigger>
                                            <DataTrigger Binding="{Binding CurrentBranchItem}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsBranchOperationBusy}" Value="True"><Setter Property="IsHitTestVisible" Value="False"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ContentControl x:Name="CurrentBranchRow" Content="{Binding CurrentBranchItem}" ContentTemplate="{StaticResource BranchRowTemplate}"/>
                            </Border>
                            <TextBlock Text="{Binding CurrentBranch}" Foreground="#58A6FF" FontWeight="SemiBold" Margin="0,0,0,6">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding CurrentBranchItem}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <StackPanel x:Name="RepositoryActionButtons" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="DiffButton" Content="差分" Style="{StaticResource RepositoryActionButtonStyle}"
                                        ToolTip="未コミットの変更を表示 (Ctrl+D)" Click="DiffButton_Click" GotKeyboardFocus="RepositoryActionButton_GotKeyboardFocus"/>
                                <Button x:Name="CommitButton" Content="コミット" Style="{StaticResource RepositoryActionButtonStyle}"
                                        ToolTip="現在の変更をすべてコミット" Click="CommitButton_Click" GotKeyboardFocus="RepositoryActionButton_GotKeyboardFocus"/>
                                <Button x:Name="PushButton" Content="プッシュ" Style="{StaticResource RepositoryActionButtonStyle}"
                                        ToolTip="現在のブランチをプッシュ" Click="PushButton_Click" GotKeyboardFocus="RepositoryActionButton_GotKeyboardFocus"/>
                                <Button x:Name="PullButton" Content="プル" Style="{StaticResource RepositoryActionButtonStyle}"
                                        ToolTip="現在のブランチをプル" Click="PullButton_Click" GotKeyboardFocus="RepositoryActionButton_GotKeyboardFocus"/>
                                <Button x:Name="RenameButton" Content="リネーム" Style="{StaticResource RepositoryActionButtonStyle}"
                                        ToolTip="現在のブランチ名を変更" Click="RenameButton_Click" GotKeyboardFocus="RepositoryActionButton_GotKeyboardFocus"/>
                            </StackPanel>
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="検索" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="BranchSearchBox" Grid.Column="1" Text="{Binding BranchSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Foreground="White" Background="#2D2D2D" BorderBrush="#555555" CaretBrush="White" Padding="6,3">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBranchOperationBusy}" Value="True">
                                                <Setter Property="IsReadOnly" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding BranchOperationMessage}"
                                   Foreground="#D4D4D4" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Button x:Name="AddBranchButton" DockPanel.Dock="Bottom" Content="＋" ToolTip="{Binding AddOperationToolTip}"
                                ToolTipService.ShowsToolTipOnKeyboardFocus="False"
                                HorizontalAlignment="Left" Margin="2,4,0,0" Padding="10,2"
                                Foreground="White"
                                FocusVisualStyle="{x:Null}" Click="AddBranchButton_Click"
                                GotKeyboardFocus="AddBranchButton_GotKeyboardFocus">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GitActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBranchOperationBusy}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ListBox x:Name="BranchList" Background="Transparent"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="BranchList_SelectionChanged" ItemTemplate="{StaticResource BranchRowTemplate}">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="ItemsSource" Value="{Binding BranchView}"/>
                                    <Setter Property="SelectionMode" Value="Extended"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStashMode}" Value="True">
                                            <Setter Property="ItemsSource" Value="{Binding Stashes}"/>
                                            <Setter Property="SelectionMode" Value="Single"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBranchOperationBusy}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="Transparent" BorderBrush="Transparent"
                                                        BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#163849"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
            
            <TextBox x:Name="CommandInputBox" Grid.Row="3" 
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                     BorderThickness="0" 
                     VerticalContentAlignment="Center" Padding="8,0"
                     FontSize="14" Height="32"
                     PreviewKeyDown="CommandInputBox_PreviewKeyDown">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="#2D2D2D"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMoveMode}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHistoryMode}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOperateMode}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </TextBox.Resources>
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding ExecuteCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Border Grid.RowSpan="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,12,0"
                    Padding="10"
                    Background="#121212"
                    BorderBrush="#007ACC"
                    BorderThickness="1"
                    CornerRadius="6"
                    MaxWidth="240"
                    Panel.ZIndex="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMoveMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="ウィンドウ移動モード"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="・矢印: ウィンドウ移動&#x0a;・Shift+矢印: サイズ変更&#x0a;・Esc: 移動モード終了"
                               Foreground="#D4D4D4"
                               FontFamily="Consolas"
                               FontSize="11"
                               LineHeight="16"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
